{
  "name": "agopify",
  "private": true,
  "version": "0.1.0",
  "description": "Agopify — Premium AI Sales Agents SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "theme:create": "node scripts/create-theme.mjs",
    "theme:build": "node scripts/build-theme-catalog.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "theme:seal": "node scripts/seal-theme-releases.mjs",
    "theme:test": "node --test packages/themes/test/*.test.js",
    "theme:test:store": "node --experimental-strip-types --test apps/store/test/theme-runtime.test.mjs",
    "dev": "node scripts/docker.mjs dev",
    "dev:store": "node scripts/docker.mjs dev",
    "dev:redis": "node scripts/docker.mjs dev --profile redis",
    "dev:all": "node scripts/docker.mjs dev --profile redis",
    "docker:up": "node scripts/docker.mjs dev",
    "docker:down": "node scripts/docker.mjs down",
    "docker:logs": "node scripts/docker.mjs logs",
    "docker:ps": "node scripts/docker.mjs ps",
    "docker:clean-legacy": "node scripts/docker.mjs clean-legacy",
    "docker:up:prod": "docker compose up -d --build --remove-orphans --wait",
    "docker:down:prod": "docker compose down",
    "docker:logs:prod": "docker compose logs -f --tail 200",
    "docker:ps:prod": "docker compose ps",
    "deploy": "bash scripts/deploy.sh",
    "deploy:pull": "bash scripts/deploy.sh --pull",
    "backup": "bash scripts/backup.sh",
    "backup:restore": "bash scripts/restore-backup.sh",
    "bootstrap:host": "sudo bash scripts/bootstrap-host.sh",
    "bootstrap:host:generate": "bash scripts/bootstrap-host.sh --generate-only",
    "test:docker": "node scripts/docker.mjs test",
    "build": "npm run build -w @agopify/api && npm run build -w @agopify/web && npm run build -w @agopify/store",
    "build:api": "npm run build -w @agopify/api",
    "build:web": "npm run build -w @agopify/web",
    "build:store": "npm run build -w @agopify/store",
    "lint": "npm run lint -w @agopify/api --if-present && npm run lint -w @agopify/web --if-present",
    "icons:sync": "node scripts/sync-icons.mjs",
    "prisma:generate": "npm run prisma:generate -w @agopify/api",
    "prisma:migrate": "npm run prisma:migrate -w @agopify/api",
    "taxonomy:load": "node scripts/load-catalog-taxonomy.mjs",
    "eval:sales": "npm run eval:sales -w @agopify/api",
    "eval:ai-core-training": "node scripts/evaluate-ai-core-training.cjs",
    "train:ai-core": "node scripts/train-ai-core.mjs"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.5"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    },
    "glob": "^13.0.6"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "@scarf/scarf": false,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "prisma": true,
    "unrs-resolver": true
  },

  "engines": {
    "node": ">=22"
  }
}
