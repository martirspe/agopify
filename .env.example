# Agopify — desarrollo local.
# `npm run dev` crea/completa apps/api/.env desde aquí (secretos aleatorios).
# Docker sobrescribe PORT, DATABASE_URL, CORS_ORIGIN y URLs públicas en el contenedor.

PORT=3000
CORS_ORIGIN=http://localhost:4200
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:4300
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agopify?schema=public

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_DAYS=30

PAYMENT_CREDENTIALS_KEY=replace-with-64-hex-chars
CHANNEL_CREDENTIALS_KEY=
# Cifrado de credenciales Magento/WooCommerce/… (Integration Core)
INTEGRATION_CREDENTIALS_KEY=

META_VERIFY_TOKEN=replace-with-meta-verify-token
# META_APP_SECRET=

MEDIA_STORAGE=local
UPLOADS_DIR=uploads
EMAIL_MODE=preview
EMAIL_PROVIDER=ses
# Redis solo con `npm run dev:redis` (opcional; sin él los locks usan Postgres)
# REDIS_URL=redis://redis:6379/0
SALES_ENGINE_MODE=ai-core

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Turnstile de prueba Cloudflare (solo local)
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Planes (flujo A); sin esto desarrollo simula el pago
# PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
# PLATFORM_MERCADOPAGO_PUBLIC_KEY=
# PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
