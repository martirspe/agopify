# VendedorIA — desarrollo local
# `npm run dev` crea/completa apps/api/.env desde este archivo (secretos aleatorios).
# Docker Compose sobrescribe PORT, DATABASE_URL, CORS_ORIGIN y URLs públicas en el contenedor.

# Application
PORT=3000
CORS_ORIGIN=http://localhost:4200
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:4300

# PostgreSQL (host) / en Docker el compose usa postgres:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendedoria?schema=public

# Auth (mínimo 32 caracteres; setup-local genera valores reales si faltan)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-32+
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-32+
JWT_REFRESH_EXPIRES_DAYS=30

# Cifrado de credenciales de pago de cada tenant (openssl rand -hex 32). No rotar tras conectar MP.
PAYMENT_CREDENTIALS_KEY=replace-with-64-hex-chars

# Cobro de planes a negocios (flujo A) — cuenta Mercado Pago de VendedorIA.
# Sin las tres, desarrollo simula el pago del plan.
# PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
# PLATFORM_MERCADOPAGO_PUBLIC_KEY=
# PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=

# Correos de pedidos: preview (no envía) o live
EMAIL_MODE=preview
EMAIL_PROVIDER=ses
# EMAIL_FROM=VendedorIA <pedidos@example.pe>
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=vendedoria-transactional
# RESEND_API_KEY=

# Cloudflare Turnstile (ambas o ninguna). Claves de prueba Cloudflare solo en local.
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Meta / WhatsApp / Instagram
META_VERIFY_TOKEN=replace-with-meta-verify-token
# META_APP_SECRET=
# META_APP_ID=
# META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Cifra tokens de canal (Embedded Signup y apps del cliente). setup-local genera uno si falta.
CHANNEL_CREDENTIALS_KEY=
# INSTAGRAM_APP_SECRET=

# Dominio propio de tiendas (Cloudflare for SaaS). Sin esto, local activa dominios directo.
# CLOUDFLARE_SAAS_ZONE_ID=
# CLOUDFLARE_SAAS_API_TOKEN=
# CUSTOM_DOMAIN_CNAME_TARGET=tiendas-cname.example.pe

# IA
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Fotos: local (volumen) o s3 + CloudFront
MEDIA_STORAGE=local
UPLOADS_DIR=uploads
# MEDIA_S3_BUCKET=vendedoria-media-dev
# MEDIA_CDN_URL=https://d111111abcdef8.cloudfront.net
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Conversion / recovery (Redis en Docker: redis://redis:6379/0)
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
RECOVERY_EMAIL_FROM=

# TikTok LIVE OAuth (opcional; requiere PAYMENT_CREDENTIALS_KEY y un solo CORS HTTPS)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://api.example.pe/api/v1/integrations/tiktok-live/oauth/callback

# Motor de ventas: ai-core (producto), sales-engine-v2 (durable clásico), shadow, legacy
SALES_ENGINE_MODE=ai-core
SALES_MODEL_PROVIDER=openai
# SALES_MODEL_FALLBACK_PROVIDER=
SALES_DEBOUNCE_MS=2000
SALES_RECENT_MESSAGES_LIMIT=20
SALES_SUMMARY_THRESHOLD=5
SALES_CONTEXT_TOKEN_BUDGET=16000
SALES_MEMORY_TTL_SECONDS=1800
SALES_CUSTOMER_MEMORY_TTL_DAYS=90
SALES_LOCK_TTL_MS=30000
SALES_TOOL_TIMEOUT_MS=10000
SALES_RETRIEVAL_TOP_K=12
SALES_SIMILARITY_THRESHOLD=0.3
SALES_EMBEDDING_MODEL=text-embedding-3-small
SALES_HANDOFF_FAILURE_THRESHOLD=3
SALES_GATEWAY_CONCURRENCY=1
