# Copy to envs/prod.tfvars (git-ignored). No secrets here: AWS and Cloudflare credentials come from
# AWS_PROFILE and CLOUDFLARE_API_TOKEN.
environment        = "prod"
aws_region         = "us-east-1"
cloudflare_zone_id = "CLOUDFLARE_ZONE_ID"

media_domain = "media.agopify.com"

email_domain = "agopify.com"
email_from   = "Agopify <noreply@agopify.com>"
# Leave false when the domain already publishes a DMARC record.
manage_dmarc            = false
manage_account_settings = true
alerts_email = "alertas@agopify.com"
