# VendedorIA — producción. Copiar a .env en el VPS; nunca subir valores reales.
# deploy.sh genera si van vacíos: POSTGRES_PASSWORD, JWT_*, PAYMENT_CREDENTIALS_KEY, CHANNEL_CREDENTIALS_KEY.
# Compose calcula DATABASE_URL, CORS_ORIGIN, PUBLIC_API_BASE_URL y STOREFRONT_URL_TEMPLATE.

STORE_BASE_DOMAIN=example.pe
CONSOLE_HOST=app.example.pe
CERTBOT_EMAIL=
CLOUDFLARE_API_TOKEN=
WEB_PORT=8082
NGINX_SITE_NAME=vendedoria
TZ=America/Lima

POSTGRES_USER=vendedoria
POSTGRES_PASSWORD=
POSTGRES_DB=vendedoria

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=30

PAYMENT_CREDENTIALS_KEY=
CHANNEL_CREDENTIALS_KEY=

META_VERIFY_TOKEN=
META_APP_SECRET=

# local | s3 (con s3 rellena bucket, CDN y AWS_*)
MEDIA_STORAGE=local
UPLOADS_DIR=/app/apps/api/uploads
# MEDIA_S3_BUCKET=
# MEDIA_CDN_URL=https://media.example.pe
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# preview | live (con live rellena EMAIL_FROM)
EMAIL_MODE=preview
EMAIL_PROVIDER=ses
# EMAIL_FROM=VendedorIA <pedidos@example.pe>
# SES_CONFIGURATION_SET=vendedoria-prod-transactional

REDIS_URL=redis://redis:6379/0
SALES_ENGINE_MODE=ai-core

# Opcional — descomenta solo lo que uses
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
# PLATFORM_MERCADOPAGO_PUBLIC_KEY=
# PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# META_APP_ID=
# META_WHATSAPP_CONFIG_ID=
# META_GRAPH_VERSION=v26.0
# CLOUDFLARE_SAAS_ZONE_ID=
# CLOUDFLARE_SAAS_API_TOKEN=
# CUSTOM_DOMAIN_CNAME_TARGET=
