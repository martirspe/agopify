# VendedorIA — producción (copiar a .env en el servidor; nunca subir valores reales).
# Desplegar con: bash scripts/deploy.sh
# docker-compose.yml calcula DATABASE_URL, CORS_ORIGIN, PUBLIC_API_BASE_URL y
# STOREFRONT_URL_TEMPLATE a partir de STORE_BASE_DOMAIN / CONSOLE_HOST.
# Vacíos generados en el primer deploy: POSTGRES_PASSWORD, JWT_*, PAYMENT_CREDENTIALS_KEY,
# CHANNEL_CREDENTIALS_KEY.

# Dominios. DNS Cloudflare (solo DNS, nube gris): A @ y A * → IP del VPS.
STORE_BASE_DOMAIN=example.pe
CONSOLE_HOST=app.example.pe

CERTBOT_EMAIL=
CLOUDFLARE_API_TOKEN=

WEB_PORT=8082
NGINX_SITE_NAME=vendedoria
TZ=America/Lima

POSTGRES_USER=vendedoria
POSTGRES_PASSWORD=
POSTGRES_DB=vendedoria

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_DAYS=30

# Meta. Sin META_APP_SECRET producción rechaza webhooks de WhatsApp.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v26.0
CHANNEL_CREDENTIALS_KEY=
INSTAGRAM_APP_SECRET=

# Dominio propio (Cloudflare for SaaS). Sin esto no se ofrece en producción.
CLOUDFLARE_SAAS_ZONE_ID=
CLOUDFLARE_SAAS_API_TOKEN=
CUSTOM_DOMAIN_CNAME_TARGET=

# Turnstile Managed (hostname STORE_BASE_DOMAIN). Ambas o ninguna.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

PAYMENT_CREDENTIALS_KEY=

# Planes (flujo A) — webhook: https://CONSOLE_HOST/api/v1/webhooks/billing/mercadopago
PLATFORM_MERCADOPAGO_ACCESS_TOKEN=
PLATFORM_MERCADOPAGO_PUBLIC_KEY=
PLATFORM_MERCADOPAGO_WEBHOOK_SECRET=

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

EMAIL_MODE=preview
EMAIL_PROVIDER=ses
# EMAIL_FROM=VendedorIA <pedidos@example.pe>
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=vendedoria-prod-transactional
# RESEND_API_KEY=

MEDIA_STORAGE=local
UPLOADS_DIR=/app/apps/api/uploads
# MEDIA_S3_BUCKET=vendedoria-media-prod
# MEDIA_CDN_URL=https://media.example.pe

# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# API_MEMORY_LIMIT=512M
# WEB_MEMORY_LIMIT=384M
# STORE_MEMORY_LIMIT=512M
# POSTGRES_MEMORY_LIMIT=512M

REDIS_URL=redis://redis:6379/0
QDRANT_URL=
QDRANT_API_KEY=
RECOVERY_EMAIL_FROM=

# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://CONSOLE_HOST/api/v1/integrations/tiktok-live/oauth/callback

SALES_ENGINE_MODE=ai-core
SALES_MODEL_PROVIDER=openai
# SALES_MODEL_FALLBACK_PROVIDER=
SALES_DEBOUNCE_MS=2000
SALES_RECENT_MESSAGES_LIMIT=20
SALES_SUMMARY_THRESHOLD=5
SALES_CONTEXT_TOKEN_BUDGET=16000
SALES_MEMORY_TTL_SECONDS=1800
SALES_CUSTOMER_MEMORY_TTL_DAYS=90
SALES_LOCK_TTL_MS=30000
SALES_TOOL_TIMEOUT_MS=10000
SALES_RETRIEVAL_TOP_K=12
SALES_SIMILARITY_THRESHOLD=0.3
SALES_EMBEDDING_MODEL=text-embedding-3-small
SALES_HANDOFF_FAILURE_THRESHOLD=3
SALES_GATEWAY_CONCURRENCY=1
